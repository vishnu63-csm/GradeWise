{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "routes/**",
          "models/**",
          "middleware/**",
          "utils/**"
        ]
      }
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/api/(.*)",  "dest": "/api/index.js" },
    { "src": "/health",    "dest": "/api/index.js" },
    { "src": "/admin",     "dest": "/public/admin.html" },
    { "src": "/admin-login", "dest": "/public/admin-login.html" },
    { "src": "/(.*\\.html)", "dest": "/public/$1" },
    { "src": "/(.*\\.css)",  "dest": "/public/$1" },
    { "src": "/(.*\\.js)",   "dest": "/public/$1" },
    { "src": "/(.*\\.png|.*\\.ico|.*\\.svg)", "dest": "/public/$1" },
    { "src": "/",          "dest": "/public/login.html" },
    { "src": "/(.*)",      "dest": "/public/login.html" }
  ]
}
